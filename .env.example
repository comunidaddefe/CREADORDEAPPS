# Configure esta URL para el gateway upstream; no apunta al dominio de la interfaz.
SOLUSOL_API_URL="https://api.solusol.net"

# Token Bearer requerido por el endpoint protegido de telemetría. Mantener solo en el servidor.
SOLUSOL_API_KEY=""

# SANTIAGO_AGENT_URL: Upstream autonomous agent orchestrator
SANTIAGO_AGENT_URL="https://santiago.solusol.net"
SANTIAGO_API_KEY=""

# En producción, Node escucha solo en loopback y el proxy HTTPS publica apps.solusol.net.
HOST=127.0.0.1
PORT=3000

# Origen permitido del frontend publicado.
ALLOWED_ORIGIN=https://apps.solusol.net

# Definir NODE_ENV=production en el gestor de procesos al desplegar.
